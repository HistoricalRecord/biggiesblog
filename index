<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Biggies blog</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Creepster&family=Fira+Code:wght@400;600&family=Metal+Mania&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-black: #050505;
      --card-bg: #0d0d0d;
      --card-border: #1a1a1a;
      --slime-green: #39ff14;
      --slime-dim: #27b80d;
      --slime-glow: rgba(57, 255, 20, 0.4);
      --halloween-orange: #ff6600;
      --orange-dim: #cc5200;
      --orange-glow: rgba(255, 102, 0, 0.4);
      --text-main: #e0e0e0;
      --text-muted: #888888;
      --delete-red: #ff3333;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-black);
      background-image: 
        radial-gradient(circle at 15% 20%, rgba(57, 255, 20, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 85% 80%, rgba(255, 102, 0, 0.05) 0%, transparent 40%),
        linear-gradient(to bottom, rgba(5,5,5,0.92), rgba(5,5,5,0.98)),
        url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 80 80"><path d="M40 0 L45 35 L80 40 L45 45 L40 80 L35 45 L0 40 L35 35 Z" fill="%23111111" opacity="0.3"/></svg>');
      color: var(--text-main);
      font-family: 'Fira Code', monospace, monospace;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 15px;
    }

    .rune-divider {
      text-align: center;
      color: var(--slime-dim);
      font-size: 0.85rem;
      letter-spacing: 6px;
      user-select: none;
      margin: 10px 0;
      text-shadow: 0 0 5px var(--slime-glow);
    }

    /* Clear High-Contrast Header */
    header {
      text-align: center;
      padding: 30px 15px 20px;
      border: 3px solid var(--slime-green);
      background: #000000;
      box-shadow: 0 0 20px var(--slime-glow), inset 0 0 10px var(--slime-glow);
      position: relative;
      margin-bottom: 20px;
      border-radius: 6px;
    }

    .sigil-top {
      font-size: 2rem;
      color: var(--halloween-orange);
      text-shadow: 0 0 8px var(--orange-glow);
      margin-bottom: 5px;
    }

    h1 {
      font-family: 'Creepster', cursive;
      font-size: clamp(2.8rem, 7vw, 4.8rem);
      color: var(--slime-green);
      text-shadow: 
        0 0 8px #000000,
        0 0 15px var(--slime-green),
        0 0 30px var(--slime-glow);
      letter-spacing: 4px;
      line-height: 1.1;
      text-transform: uppercase;
    }

    .subheading {
      font-family: 'Metal Mania', cursive;
      color: var(--halloween-orange);
      font-size: clamp(1rem, 2.5vw, 1.3rem);
      margin-top: 10px;
      letter-spacing: 1px;
      text-shadow: 0 0 8px var(--orange-glow);
    }

    .controls-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #0a0a0a;
      border: 1px solid var(--orange-dim);
      padding: 12px 18px;
      margin-bottom: 20px;
      border-radius: 4px;
    }

    .log-counter {
      color: var(--halloween-orange);
      font-weight: 600;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .main-grid {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 20px;
      flex-grow: 1;
    }

    @media (max-width: 850px) {
      .main-grid {
        grid-template-columns: 1fr;
      }
    }

    .panel {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 4px;
      padding: 20px;
      display: flex;
      flex-direction: column;
    }

    .panel-title {
      font-family: 'Metal Mania', cursive;
      color: var(--halloween-orange);
      font-size: 1.3rem;
      border-bottom: 1px dashed var(--orange-dim);
      padding-bottom: 8px;
      margin-bottom: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .log-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-height: 650px;
      overflow-y: auto;
      padding-right: 5px;
    }

    .log-list::-webkit-scrollbar {
      width: 6px;
    }
    .log-list::-webkit-scrollbar-track {
      background: #050505;
    }
    .log-list::-webkit-scrollbar-thumb {
      background: var(--orange-dim);
    }

    .log-item {
      background: #080808;
      border: 1px solid #1a1a1a;
      border-left: 3px solid var(--orange-dim);
      padding: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      border-radius: 2px;
    }

    .log-item:hover {
      border-color: var(--slime-dim);
      border-left-color: var(--slime-green);
      background: #111;
      transform: translateX(3px);
    }

    .log-item.active {
      border-color: var(--slime-green);
      border-left: 4px solid var(--slime-green);
      background: rgba(57, 255, 20, 0.05);
      box-shadow: 0 0 8px rgba(57, 255, 20, 0.2);
    }

    .log-item-date {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-bottom: 4px;
      display: flex;
      justify-content: space-between;
    }

    .log-item-title {
      color: var(--text-main);
      font-weight: 600;
      font-size: 0.95rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .log-item.active .log-item-title {
      color: var(--slime-green);
    }

    .reader-header {
      margin-bottom: 20px;
      border-bottom: 1px solid #222;
      padding-bottom: 15px;
    }

    .reader-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .reader-meta {
      display: flex;
      gap: 15px;
      font-size: 0.85rem;
      color: var(--halloween-orange);
    }

    .btn-delete {
      background: rgba(255, 51, 51, 0.1);
      color: var(--delete-red);
      border: 1px solid var(--delete-red);
      padding: 5px 12px;
      font-family: 'Fira Code', monospace;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      border-radius: 3px;
      transition: all 0.2s ease;
    }

    .btn-delete:hover {
      background: var(--delete-red);
      color: #000;
      box-shadow: 0 0 8px rgba(255, 51, 51, 0.5);
    }

    .reader-title {
      font-size: 1.8rem;
      color: var(--slime-green);
      text-shadow: 0 0 8px var(--slime-glow);
      line-height: 1.3;
    }

    .reader-content {
      line-height: 1.8;
      font-size: 1.05rem;
      color: #e0e0e0;
      white-space: pre-wrap;
      flex-grow: 1;
    }

    .empty-state {
      text-align: center;
      padding: 50px 20px;
      color: var(--text-muted);
    }

    .empty-state .sigil {
      font-size: 3rem;
      color: var(--orange-dim);
      margin-bottom: 15px;
    }

    footer {
      text-align: center;
      margin-top: 30px;
      padding: 15px;
      font-size: 0.8rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>

  <header>
    <div class="sigil-top">🜏 ☾ 🜔</div>
    <h1>BIGGIE’S BLOG</h1>
    <div class="subheading">Biggie’s personal blog. Who’s Biggie? Who cares!</div>
  </header>

  <div class="rune-divider">ᛞ ᚨ ᚱ ᚲ ᛟ ᚾ ᛚ ᛦ ᚠ ᛟ ᚱ ᛖ ᚠ ᛖ ᚱ</div>

  <div class="controls-bar">
    <div class="log-counter">
      <span>🕮</span> <span id="entry-count-text">1 Entry Logged</span>
    </div>
  </div>

  <main class="main-grid">
    <!-- Sidebar: Clickable Daily Log List -->
    <section class="panel">
      <div class="panel-title">
        <span>Daily Journal Entries</span>
        <span style="font-size: 0.9rem; color: var(--slime-green);">☾</span>
      </div>
      <ul class="log-list" id="log-list">
        <!-- Log entries populated via JS -->
      </ul>
    </section>

    <!-- Main Content Area: Selected Entry Reader -->
    <section class="panel" id="reader-panel">
      <div class="empty-state" id="empty-state" style="display: none;">
        <div class="sigil">🜏</div>
        <p>No entry selected or all entries have been deleted.</p>
      </div>
      <div id="reader-content-wrap">
        <div class="reader-header">
          <div class="reader-meta-row">
            <div class="reader-meta">
              <span id="reader-date">2026-10-30</span>
              <span>•</span>
              <span id="reader-mood">Mood: Reflective / Relaxing</span>
            </div>
            <button class="btn-delete" id="delete-btn" onclick="deleteCurrentEntry()">✕ Delete Entry</button>
          </div>
          <h2 class="reader-title" id="reader-title">First Day Blogging & Halloween Thoughts</h2>
        </div>
        <div class="reader-content" id="reader-body">Today is my first day blogging. I don’t know exactly what I will add here, but I’m interested in sharing my thoughts somewhere and having them documented for the future. I like to look back and see how things have changed. Opinions, what is important to me, so on and so forth.

Today I’m just relaxing while my wife is at work. I have two herniated discs in my back and haven’t worked since last September. Trying to get disability is going… well it’s going, I think. The system really sucks as far as turnaround. Average of 6 months they say.

I’m not exactly feeling the Halloween spirit. Don’t get me wrong I love Halloween, but October has seemingly come and went this year. We didn’t decorate and I didn’t really watch any Halloween or horror movies.

We have 2 more nights to capture the spirit. Today is the 30th of October, 2026 and tomorrow is Halloween. I think tonight I will try to get my wife in a spooky mood and we will consume some festive media.

Either way, I hope anyone who eventually reads this has or had a wonderful and safe Halloween. It’s such a wonderful and fun holiday, especially for kids. I loved Halloween so much growing up. The costumes, the candy, the television specials, the weather, etc. It’s always been magical.</div>
      </div>
    </section>
  </main>

  <div class="rune-divider">ᛞ ᚨ ᚱ ᚲ ᛟ ᚾ ᛚ ᛦ ᚠ ᛟ ᚱ ᛖ ᚠ ᛖ ᚱ</div>

  <footer>
    <p>BIGGIE’S BLOG &copy; 2026 — All rights reserved in the dark.</p>
  </footer>

  <script>
    // ==========================================
    // YOUR BLOG POSTS
    // ==========================================
    let myPosts = [
      {
        id: '1',
        date: '2026-10-30',
        title: 'First Day Blogging & Halloween Thoughts',
        mood: 'Reflective / Relaxing',
        body: `Today is my first day blogging. I don’t know exactly what I will add here, but I’m interested in sharing my thoughts somewhere and having them documented for the future. I like to look back and see how things have changed. Opinions, what is important to me, so on and so forth.

Today I’m just relaxing while my wife is at work. I have two herniated discs in my back and haven’t worked since last September. Trying to get disability is going… well it’s going, I think. The system really sucks as far as turnaround. Average of 6 months they say.

I’m not exactly feeling the Halloween spirit. Don’t get me wrong I love Halloween, but October has seemingly come and went this year. We didn’t decorate and I didn’t really watch any Halloween or horror movies.

We have 2 more nights to capture the spirit. Today is the 30th of October, 2026 and tomorrow is Halloween. I think tonight I will try to get my wife in a spooky mood and we will consume some festive media.

Either way, I hope anyone who eventually reads this has or had a wonderful and safe Halloween. It’s such a wonderful and fun holiday, especially for kids. I loved Halloween so much growing up. The costumes, the candy, the television specials, the weather, etc. It’s always been magical.`
      }
    ];
    // ==========================================

    let activeEntryId = '1';

    function renderLogList() {
      const listEl = document.getElementById('log-list');
      const countEl = document.getElementById('entry-count-text');

      countEl.textContent = `${myPosts.length} ${myPosts.length === 1 ? 'Entry' : 'Entries'} Logged`;
      listEl.innerHTML = '';

      if (myPosts.length === 0) {
        listEl.innerHTML = '<li style="color: var(--text-muted); padding: 15px; text-align: center; font-size: 0.85rem;">No entries published yet.</li>';
        return;
      }

      myPosts.forEach(entry => {
        const li = document.createElement('li');
        li.className = `log-item ${entry.id === activeEntryId ? 'active' : ''}`;
        li.onclick = () => selectEntry(entry.id);

        li.innerHTML = `
          <div class="log-item-date">
            <span>${entry.date}</span>
            <span>${entry.mood ? `[${entry.mood}]` : ''}</span>
          </div>
          <div class="log-item-title">${escapeHtml(entry.title)}</div>
        `;

        listEl.appendChild(li);
      });
    }

    function selectEntry(id) {
      activeEntryId = id;
      const entry = myPosts.find(e => e.id === id);

      const emptyState = document.getElementById('empty-state');
      const contentWrap = document.getElementById('reader-content-wrap');

      if (!entry) {
        emptyState.style.display = 'block';
        contentWrap.style.display = 'none';
        return;
      }

      emptyState.style.display = 'none';
      contentWrap.style.display = 'block';

      document.getElementById('reader-date').textContent = entry.date;
      document.getElementById('reader-mood').textContent = entry.mood ? `Mood: ${entry.mood}` : 'Mood: Unspecified';
      document.getElementById('reader-title').textContent = entry.title;
      document.getElementById('reader-body').textContent = entry.body;

      renderLogList();
    }

    function deleteCurrentEntry() {
      if (!activeEntryId) return;

      if (confirm('Are you sure you want to delete this blog post?')) {
        myPosts = myPosts.filter(e => e.id !== activeEntryId);
        activeEntryId = myPosts.length > 0 ? myPosts[0].id : null;

        if (activeEntryId) {
          selectEntry(activeEntryId);
        } else {
          document.getElementById('empty-state').style.display = 'block';
          document.getElementById('reader-content-wrap').style.display = 'none';
          renderLogList();
        }
      }
    }

    function escapeHtml(str) {
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    // Initialize Page
    renderLogList();
    if (myPosts.length > 0) {
      selectEntry(myPosts[0].id);
    }
  </script>
</body>
</html>
